{
  "name": "neteasemusiccloudmanager",
  "version": "2.5.6",
  "description": "NetEase Cloud Music cloud disk manager CLI",
  "main": "dist/cli/index.js",
  "bin": {
    "ncm-cloud": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "bun src/cli/index.ts",
    "dev:tui": "bun src/cli/index.ts tui",
    "build": "tsc -p tsconfig.json",
    "start": "bun dist/cli/index.js",
    "start:tui": "bun dist/cli/index.js tui",
    "typecheck": "tsc --noEmit",
    "compile": "bun scripts/build.ts",
    "compile:win": "bun scripts/build.ts windows-x64",
    "compile:linux": "bun scripts/build.ts linux-x64",
    "compile:mac": "bun scripts/build.ts darwin-arm64"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "@neteasecloudmusicapienhanced/api": "^4.32.1",
    "@opentui/core": "^0.2.12",
    "@vincentkoc/qrcode-tui": "^0.2.1",
    "axios": "^1.16.1",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "conf": "^15.1.0",
    "fast-glob": "^3.3.3",
    "music-metadata": "^11.12.3",
    "p-queue": "^9.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "string-similarity": "^4.0.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/cli-progress": "^3.11.6",
    "@types/string-similarity": "^4.0.2",
    "typescript": "^6.0.3"
  }
}
