{
  "name": "neteasemusiccloudmanager",
  "version": "2.1.0",
  "description": "NetEase Cloud Music cloud disk manager CLI",
  "main": "dist/cli/index.js",
  "bin": {
    "ncm-cloud": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "bun src/cli/index.ts",
    "dev:tui": "bun src/cli/index.ts tui",
    "build": "tsc -p tsconfig.json",
    "start": "bun dist/cli/index.js",
    "start:tui": "bun dist/cli/index.js tui",
    "typecheck": "tsc --noEmit",
    "generate:api": "bun scripts/generate-embedded-api.ts",
    "compile": "bun run generate:api && bun build src/cli/index.ts --compile --outfile artifacts/ncm-cloud",
    "compile:win": "bun run generate:api && bun build src/cli/index.ts --compile --target=bun-windows-x64 --outfile artifacts/ncm-cloud-win.exe",
    "compile:linux": "bun run generate:api && bun build src/cli/index.ts --compile --target=bun-linux-x64 --outfile artifacts/ncm-cloud-linux"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@inquirer/prompts": "^8.4.1",
    "@neteasecloudmusicapienhanced/api": "^4.31.0",
    "@opentui/core": "0.2.9",
    "@vincentkoc/qrcode-tui": "^0.2.1",
    "axios": "^1.15.0",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "conf": "^15.1.0",
    "fast-glob": "^3.3.3",
    "music-metadata": "^11.12.3",
    "p-queue": "^9.1.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "string-similarity": "^4.0.4"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/cli-progress": "^3.11.6",
    "@types/string-similarity": "^4.0.2",
    "typescript": "^6.0.2"
  }
}
